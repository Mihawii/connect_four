# ─────────────────────────────────────────────────────────────────────────────
# Inferno environment variables. Copy this file to `.env.local` and fill in.
# Anything UNSET will gracefully degrade: the app boots, local play works,
# but features needing that key (auth, multiplayer, coach, payments) stay off.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (auth + DB + Realtime) ─────────────────────────────────────────
# Get from supabase.com → your project → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (AI coach) ───────────────────────────────────────────────────────
# Get from platform.openai.com → API Keys.
OPENAI_API_KEY=

# Optional: pin a coach model. Defaults to gpt-4o-mini if unset.
OPENAI_COACH_MODEL=gpt-4o-mini

# ── Stripe (subscriptions + skins) ──────────────────────────────────────────
# Get from dashboard.stripe.com → Developers → API keys. Use TEST keys.
STRIPE_SECRET_KEY=
# Optional alternative for restricted test/live keys with Checkout permissions.
STRIPE_RESTRICTED_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs (create products first, then paste their price IDs)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_LIFETIME=
STRIPE_PRICE_BATTLE_PASS=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: PostHog analytics (off if unset)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
